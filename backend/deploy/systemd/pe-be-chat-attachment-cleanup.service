[Unit]
Description=PE Backend chat attachment cleanup
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/pe-be
EnvironmentFile=-/srv/pe-be/backend/.env.production
TimeoutStartSec=300
ExecStart=/usr/bin/bash /srv/pe-be/backend/deploy/blue-green.sh run python -m src.jobs.chat_attachment_cleanup
